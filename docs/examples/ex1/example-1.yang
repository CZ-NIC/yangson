module example-1 {

  yang-version 1.1;

  namespace "http://example.com/example-1";

  prefix ex1;

  leaf greeting {
    type string;
    default "Hello, world!";
  }

  rpc howdy {
    input {
      leaf address {
        type string;
      }
    }
    output {
      leaf response {
        type string;
      }
    }
  }
}
